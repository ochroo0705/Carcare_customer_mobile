<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" no longer covers device-to-device
     transfer, so exclude everything from both cloud backup and transfer.
     See the note on allowBackup in AndroidManifest.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
