GOOGLE_MAP_API_KEY=

# Loaded into the app at build time via --dart-define-from-file=.env (see
# lib/core/config/app_environment.dart and docs/GOOGLE_MAPS_SETUP.md).
# API_BASE_URL: the customer API to talk to. Android emulators can't reach
# "localhost" for the host machine's server — use 10.0.2.2, or your LAN IP
# for a physical device.
# USE_FAKE_API: false talks to a real API_BASE_URL; true uses in-memory
# fake repositories (no backend needed) — see COWORK.md D-004.
API_BASE_URL=http://10.0.2.2:4000/api/v1/app
USE_FAKE_API=false
